<Project>
  <!-- Product and version for every Atlas3K project; the About box and the start page read InformationalVersion. -->
  <PropertyGroup>
    <Product>Atlas3K</Product>
    <Company>Atlas3K</Company>
    <Copyright>Copyright (c) 2026 Atlas3K contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.3</VersionSuffix>
    <!-- appends +<commit> to InformationalVersion when built from git -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="Atlas3KSourceRevision" BeforeTargets="GetAssemblyVersion;AddSourceRevisionToInformationalVersion" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildThisFileDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_Atlas3KRevision" />
      <Output TaskParameter="ExitCode" PropertyName="_Atlas3KGitExit" />
    </Exec>
    <!-- only a real commit id: without git on PATH the output is an error message -->
    <PropertyGroup Condition="'$(_Atlas3KGitExit)' == '0'">
      <SourceRevisionId>$(_Atlas3KRevision)</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
