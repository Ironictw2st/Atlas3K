{
  // Atlas3K project for the 190E main map: the same build as kit_edits_build.sh (native compile from the kit as it
  // is, tile-hole report, tree filter, merge into the native test pack).
  // Not included: the script's /z/Claude/Headless/HOLD touch / delete (other sessions use HOLD too; add it as a custom step if wanted).
  // Open in Atlas3K (Build window) or run:
  //   Atlas3K.Cli.exe build --project research/main190/main190.atlas3k
  "name": "190E main map",
  "map": "3k_190e_expanded_map",
  "assemblyKit": "C:\\Program Files (x86)\\Steam\\steamapps\\common\\Total War THREE KINGDOMS\\assembly_kit_190E",
  "build": {
    "output": "{ak}\\working_data",
    "steps": ["rasters", "tile_list", "global_map", "global_mesh", "rivers", "global_props", "camera_heightmap", "trees"],
    "acceptTileMap": ["layout.mesh_columns"],
    "clean": ["global_meshes", "height_patches", "models"],
    "backup": "{project}\\..\\..\\output\\backups\\main190_kit_edits_last",
    "customSteps": [
      {
        "name": "tile holes report",
        "runAt": "afterCompile",
        "command": "python",
        "arguments": "tile_holes.py \"{out}\\terrain\\campaigns\\{map}\\tile_list.bin\" hex/map.hex holes/rr_tile.png --all --top 10",
        "continueOnError": true
      },
      {
        "name": "tree filter",
        "runAt": "afterCompile",
        "command": "python",
        "arguments": "tree_filter_step.py \"{out}\\campaign_maps\\{map}\\display\\trees\\trees.campaign_tree_list\""
      }
    ],
    "pack": {
      "enabled": true,
      "mode": "merge",
      "output": "{game}\\!!190_expanded_region_test_main190_native.pack",
      "replaceDirs": ["terrain/campaigns/{map}/"],
      "contents": [
        { "source": "stage_newmap_terrain\\ambient_light_probes", "path": "terrain/campaigns/{map}/ambient_light_probes" },
        { "source": "{out}\\terrain\\campaigns\\{map}", "path": "terrain/campaigns/{map}" },
        { "source": "stage_newmap_terrain\\environment_collection.xml", "path": "terrain/campaigns/{map}/environment_collection.xml" },
        { "source": "{out}\\campaign_maps\\{map}\\camera_heightmap.png", "path": "campaign_maps/{map}/camera_heightmap.png" },
        { "source": "{out}\\campaign_maps\\{map}\\display\\trees\\trees.campaign_tree_list", "path": "campaign_maps/{map}/display/trees/trees.campaign_tree_list" },
        { "source": "{project}\\..\\..\\output\\lake_assets\\{map}\\rigidmodels\\campaign\\props\\lakes", "path": "rigidmodels/campaign/props/lakes", "optional": true }
      ]
    },
    "install": { "enabled": false }
  }
}
